{
  "$defs": {
    "Alternate": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "description": "Category ids for this display.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "description": {
          "description": "Long description of this display.",
          "type": "string"
        },
        "id": {
          "description": "Source identifier of this display.",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Value",
          "description": "Cell meaning and conversion for this display."
        },
        "view": {
          "$ref": "#/$defs/View",
          "description": "Display settings for this display."
        },
        "x": {
          "$ref": "#/$defs/Value",
          "description": "Column axis display, when it differs."
        },
        "y": {
          "$ref": "#/$defs/Value",
          "description": "Row axis display, when it differs."
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "Axis": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "description": "File offset of the first breakpoint, for image axes.",
          "pattern": "^0x[0-9A-Fa-f]{1,8}$",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/Data",
          "description": "Breakpoint storage, for image axes."
        },
        "header": {
          "description": "Header bytes before the axis data (KP field DataHeader, unconfirmed); usually a point count.",
          "type": "integer"
        },
        "mirror": {
          "description": "KP \"mirror map\" axis setting: WinOLS shows the axis in descending order; storage is unchanged.",
          "type": "boolean"
        },
        "signature": {
          "description": "Marker value WinOLS associates with the axis (KP SignatureByte, the byte before the axis data; unconfirmed); omitted when none.",
          "type": "integer"
        },
        "source": {
          "description": "image: read from the image; ordinal: 1, 2, 3; editable: fixed values (KP \"Free editable\"; the values are not in the model yet); unknown: an unnamed KP datasource (written back as ordinal).",
          "enum": [
            "image",
            "ordinal",
            "editable",
            "unknown"
          ],
          "type": "string"
        },
        "stored": {
          "description": "How image values are stored: absolute; subtract: 2^bits minus the sum of the remaining raw values (docs/kp-format.md); add and backwards: semantics unknown.",
          "enum": [
            "absolute",
            "add",
            "subtract",
            "backwards"
          ],
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Value",
          "description": "Breakpoint meaning and conversion."
        },
        "view": {
          "$ref": "#/$defs/View",
          "description": "Display settings."
        }
      },
      "required": [
        "source",
        "value"
      ],
      "type": "object"
    },
    "Category": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identifier referenced by objects.",
          "type": "integer"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "Conversion": {
      "additionalProperties": false,
      "properties": {
        "factor": {
          "description": "Multiplier.",
          "type": "number"
        },
        "offset": {
          "description": "Added after the multiplication.",
          "type": "number"
        },
        "reciprocal": {
          "description": "KP reciprocal flag; exact formula unconfirmed.",
          "type": "boolean"
        }
      },
      "required": [
        "factor",
        "offset"
      ],
      "type": "object"
    },
    "Data": {
      "additionalProperties": false,
      "properties": {
        "bits": {
          "description": "Cell width in bits.",
          "enum": [
            8,
            16,
            32
          ],
          "type": "integer"
        },
        "endian": {
          "description": "Byte order of cells wider than 8 bits.",
          "enum": [
            "big",
            "little"
          ],
          "type": "string"
        },
        "float": {
          "description": "IEEE 754 floating point.",
          "type": "boolean"
        },
        "signed": {
          "description": "Two's complement integers.",
          "type": "boolean"
        }
      },
      "required": [
        "bits"
      ],
      "type": "object"
    },
    "Object": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "description": "File offset of the first cell.",
          "pattern": "^0x[0-9A-Fa-f]{1,8}$",
          "type": "string"
        },
        "alternates": {
          "description": "Other displays of the same cells. Address and storage stay on this object.",
          "items": {
            "$ref": "#/$defs/Alternate"
          },
          "type": "array"
        },
        "categories": {
          "description": "Category ids.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "cols": {
          "description": "Number of columns.",
          "type": "integer"
        },
        "comment": {
          "description": "Free-text comment.",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/Data",
          "description": "Cell storage."
        },
        "description": {
          "description": "Long description (KP name).",
          "type": "string"
        },
        "id": {
          "description": "The source's own identifier (KP id, A2L name); not unique.",
          "type": "string"
        },
        "inverse": {
          "description": "KP \"2d Inverse\" organisation; its meaning is unconfirmed (docs/kp-format.md).",
          "type": "boolean"
        },
        "key": {
          "description": "The source id. Empty when the id is blank. A repeated key is allowed.",
          "type": "string"
        },
        "marked": {
          "description": "Marked in the WinOLS map list (KP v2 Marked; unconfirmed, docs/kp-format.md).",
          "type": "boolean"
        },
        "rows": {
          "description": "Number of rows.",
          "type": "integer"
        },
        "shape": {
          "description": "value: one cell; 1d: a row of cols cells; 2d: rows by cols cells.",
          "enum": [
            "value",
            "1d",
            "2d"
          ],
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Value",
          "description": "Cell meaning and conversion."
        },
        "view": {
          "$ref": "#/$defs/View",
          "description": "Display settings."
        },
        "x": {
          "$ref": "#/$defs/Axis",
          "description": "Column axis."
        },
        "y": {
          "$ref": "#/$defs/Axis",
          "description": "Row axis."
        }
      },
      "required": [
        "id",
        "shape",
        "address",
        "rows",
        "cols",
        "data",
        "value"
      ],
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Project name.",
          "type": "string"
        },
        "version": {
          "description": "Project version.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Original file name.",
          "type": "string"
        },
        "format": {
          "description": "Source format; image: located in a flash image by a program such as me7info.",
          "enum": [
            "kp",
            "xdf",
            "image"
          ],
          "type": "string"
        },
        "origin": {
          "description": "Where the definitions came from, whatever format carried them: damos or a2l (exported from Bosch data), manual (made by hand, as KP map packs usually are), auto (found in the image by a program).",
          "enum": [
            "damos",
            "a2l",
            "manual",
            "auto"
          ],
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Reference",
          "description": "The definition an auto one was checked against."
        },
        "sha256": {
          "description": "SHA-256 of the original file (the image, for format image), lowercase hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "subset": {
          "$ref": "#/$defs/Subset",
          "description": "Set when the definition is a subset of the original file's."
        },
        "verified": {
          "description": "A person checked every definition against the image.",
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "sha256"
      ],
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "agree": {
          "description": "Names at the same address, and names in the reference.",
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "except": {
          "description": "Names the reference lists at another address, such as ESKONF.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "file": {
          "description": "The reference's file name.",
          "type": "string"
        },
        "origin": {
          "description": "The reference's origin.",
          "enum": [
            "damos",
            "a2l",
            "manual"
          ],
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the reference file, lowercase hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "unreferenced": {
          "description": "Located names the reference does not list.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "origin",
        "sha256",
        "agree"
      ],
      "type": "object"
    },
    "Subset": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "tuner: the maps of a category table and their axes (Model.Tuner).",
          "enum": [
            "tuner"
          ],
          "type": "string"
        },
        "table": {
          "description": "SHA-256 of the category table, lowercase hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "table"
      ],
      "type": "object"
    },
    "Value": {
      "additionalProperties": false,
      "properties": {
        "conversion": {
          "$ref": "#/$defs/Conversion",
          "description": "Raw to physical conversion."
        },
        "description": {
          "description": "Description of the quantity.",
          "type": "string"
        },
        "max": {
          "description": "Highest value shown. Omitted when the source has none.",
          "type": "number"
        },
        "min": {
          "description": "Lowest value shown. Omitted when the source has none.",
          "type": "number"
        },
        "precision": {
          "description": "Decimal places shown.",
          "type": "integer"
        },
        "units": {
          "description": "Physical units.",
          "type": "string"
        }
      },
      "required": [
        "precision",
        "conversion"
      ],
      "type": "object"
    },
    "View": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "description": "Number base shown (KP: 10, 16 or 2).",
          "type": "integer"
        },
        "difference": {
          "description": "Show the difference to the original.",
          "type": "boolean"
        },
        "percent": {
          "description": "Show the difference in percent.",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "$id": "https://go.nyet.org/xdfkit/model/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "categories": {
      "description": "Categories (KP folders, XDF categories), referenced by id from objects.",
      "items": {
        "$ref": "#/$defs/Category"
      },
      "type": "array"
    },
    "objects": {
      "description": "Map definitions, in source order.",
      "items": {
        "$ref": "#/$defs/Object"
      },
      "type": "array"
    },
    "project": {
      "$ref": "#/$defs/Project",
      "description": "Project metadata."
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "description": "Where the definition was converted from."
    },
    "schema": {
      "description": "Schema version.",
      "enum": [
        "xdfkit-model/1"
      ],
      "type": "string"
    },
    "stamp": {
      "description": "Edit stamp (docs/stamp-and-metadata.md).",
      "type": "object"
    }
  },
  "required": [
    "schema",
    "objects"
  ],
  "title": "xdfkit map definition model",
  "type": "object"
}
