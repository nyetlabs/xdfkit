    "Bedingung für Ansteuerung EGAS-Fehlerlampe"
    UWORD
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x1
    FORMAT "%13.11"
    
    ECU_ADDRESS 0xFD28
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0xFD28 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0xFD28 0x0 0x2 /end IF_DATA
/end MEASUREMENT

