    "Bedingung für ASR im Fahrzeug"
    UWORD
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x100
    FORMAT "%13.11"
    
    ECU_ADDRESS 0xFD00
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0xFD00 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0xFD00 0x0 0x2 /end IF_DATA
/end MEASUREMENT

