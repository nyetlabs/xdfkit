    "Bedingung Bandende Funktionsanforderung : Getriebecodierung CAN"
    UWORD
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x20
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x383B7E
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x383B7E /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x383B7E 0x1 0x2 /end IF_DATA
/end MEASUREMENT

