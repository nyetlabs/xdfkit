    "Botschaftszähler der ACC-Canbotschaft in der Überwachung"
    UBYTE
    dez
    1
    100
    0
    255

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x38080F
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x38080F /end IF_DATA
